# Copy this to .env and fill it in. .env is already in .gitignore; do not commit it.
# When deploying to Sepolia use your own test wallet's private key (test funds only!)
PRIVATE_KEY=

# Pick any Sepolia RPC: Alchemy / Infura / PublicNode
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# For verifying source at Tier 2. Free to request: https://etherscan.io/myapikey
# Deployment still succeeds if you leave it blank; only the --verify step fails (the contract
# is already on chain, and you can verify it afterwards, see the README).
ETHERSCAN_API_KEY=
